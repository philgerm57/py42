<Application x:Class="Py42.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Palette inspirée du boîtier HP-42S : anthracite, touche shift orange, écran LCD gris-vert -->
    <SolidColorBrush x:Key="Body" Color="#262624" />
    <SolidColorBrush x:Key="Bar" Color="#1C1C1A" />
    <SolidColorBrush x:Key="Ink" Color="#ECEAE4" />
    <SolidColorBrush x:Key="Muted" Color="#9C9A92" />
    <SolidColorBrush x:Key="Shift" Color="#E0892F" />
    <SolidColorBrush x:Key="ShiftHover" Color="#EE9C47" />
    <SolidColorBrush x:Key="KeyCap" Color="#3B3A37" />
    <SolidColorBrush x:Key="KeyHover" Color="#4A4945" />
    <SolidColorBrush x:Key="KeyEdge" Color="#55534E" />
    <SolidColorBrush x:Key="Lcd" Color="#C6CDB0" />
    <SolidColorBrush x:Key="LcdEdge" Color="#8E957A" />
    <SolidColorBrush x:Key="LcdInk" Color="#1E2418" />
    <SolidColorBrush x:Key="Paper" Color="#FBFAF6" />

    <Style x:Key="KeyButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="{StaticResource KeyCap}" />
      <Setter Property="BorderBrush" Value="{StaticResource KeyEdge}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Cap" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1,1,1,3" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Cap" Property="Background" Value="{StaticResource KeyHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Cap" Property="BorderThickness" Value="1,2,1,1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Cap" Property="BorderBrush" Value="{StaticResource Shift}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ShiftButton" TargetType="Button" BasedOn="{StaticResource KeyButton}">
      <Setter Property="Background" Value="{StaticResource Shift}" />
      <Setter Property="Foreground" Value="#1C1B19" />
      <Setter Property="BorderBrush" Value="#B5661C" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource ShiftHover}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="2,0,0,5" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="#33322F" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="CaretBrush" Value="{StaticResource Shift}" />
      <Setter Property="BorderBrush" Value="{StaticResource KeyEdge}" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
